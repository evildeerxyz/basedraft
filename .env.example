# Copy to .env.local and fill in.

# Supabase: accounts, data, live updates and image storage (Project Settings, API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=http://localhost:3400
# Server only, never NEXT_PUBLIC. In production these are Worker secrets (npx wrangler secret put NAME):
#   SUPABASE_SECRET_KEY     sb_secret_...: Whop's webhook records purchases with it
#   SEND_EMAIL_HOOK_SECRET  v1,whsec_...: the Send Email hook's secret (Supabase: Authentication, Hooks)
#   RESEND_API_KEY          sends basedraft's emails (sign-in codes, welcome, orders, invites)
#   EMAIL_FROM              the sender, on a domain verified in Resend: basedraft <hello@basedraft.site>
#   EMAIL_REPLY_TO          optional, where replies go (default hello@basedraft.site)
#   WHOP_API_KEY            opens Whop checkouts
#   WHOP_WEBHOOK_SECRET     the ws_ secret of the Whop webhook at <site>/api/whop/webhook
#   WHOP_PLAN_ZUNO, WHOP_PLAN_NOMA, WHOP_PLAN_AUREN, WHOP_PLAN_PELLO, WHOP_PLAN_PRO, WHOP_PLAN_TEAM   each product's Whop plan id
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET   Continue with Google, through this site: an OAuth client whose
#     redirect is <site>/api/auth/callback/google, with the same client id on Supabase's Google provider
SUPABASE_SECRET_KEY=
SEND_EMAIL_HOOK_SECRET=

# Analytics, production only. Both are public ids, safe in the browser.
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_GA_ID=G-...

# Where each template zone runs in production (locally they run on 4101 to 4103).
# ZUNO_URL=https://zuno-zone.example.com
# NOMA_URL=https://noma-zone.example.com
# AUREN_URL=https://auren-zone.example.com
# PELLO_URL=https://pello-zone.example.com

# Send to GitHub: an OAuth app (github.com/settings/developers) whose callback URL is
# <your site>/api/github/callback, for example http://localhost:3400/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Seals the GitHub token in its cookie. Any long random string; required in production.
BD_SESSION_SECRET=

# Hands out every template's code (Download project, Send to GitHub) to anyone, for a private
# preview only. Leave it off: code goes to whoever bought the template or Pro.
# BD_EXPORT_OPEN=1
