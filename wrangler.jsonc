{
  "$schema": "node_modules/wrangler/config-schema.json",
  // basedraft on Cloudflare Workers, the free plan. Built and deployed by scripts/cf-deploy.mjs.
  "name": "basedraft",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // No public preview address per upload: only the deployed version is on the web.
  "preview_urls": false,
  // basedraft.site and www.basedraft.site, as Custom Domains (Cloudflare manages their DNS records).
  "routes": [
    { "pattern": "basedraft.site", "custom_domain": true },
    { "pattern": "www.basedraft.site", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // The templates' preview pages go through the worker's guard; their scripts and styles don't.
    "run_worker_first": ["/live/*", "!/live/*/_next/*"]
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "basedraft" }],
  // The templates' code as their buyers get it (Download project, Send to GitHub): private, not in
  // the asset store. scripts/cf-deploy.mjs puts it there; src/server/site.ts reads it.
  "kv_namespaces": [{ "binding": "TEMPLATES", "id": "d2f853c2bbc44b4d90b3d55439c1b5bb" }],
  // Plain settings. NEXT_PUBLIC_* are built into the code from .env.cloudflare; they're here too so
  // the Worker's settings show everything. Secrets (BD_SESSION_SECRET, GITHUB_CLIENT_ID,
  // GITHUB_CLIENT_SECRET) are set with `wrangler secret put`, never in this file.
  "vars": {
    "BD_SOURCE": "kv",
    // Where every other address of the Worker (www, workers.dev) sends people, once it's set.
    "CANONICAL_HOST": "basedraft.site",
    "NEXT_PUBLIC_CONVEX_URL": "https://charming-giraffe-71.convex.cloud",
    "NEXT_PUBLIC_CONVEX_SITE_URL": "https://charming-giraffe-71.convex.site",
    "NEXT_PUBLIC_SITE_URL": "https://basedraft.site",
    "NEXT_PUBLIC_POSTHOG_KEY": "phc_o8pZvAYLQqjMovrkWqoV9fMpHYjUQU2ZrWPhsir6NSV7",
    "NEXT_PUBLIC_GA_ID": "G-79T3MK4DMN"
  },
  "observability": { "enabled": true }
}
